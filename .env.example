# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.

# --- Server ---
PORT=4000
# Comma-separated list of frontend origins allowed to call this API.
# Example: https://anokhisilks.netlify.app,http://localhost:8000
FRONTEND_ORIGIN=http://localhost:8000

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# --- Admin order inbox login (visit /admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_password

# --- Order email notifications (optional but recommended) ---
# Any SMTP provider works: Gmail (use an App Password, not your normal
# password), Zoho Mail, SendGrid SMTP, Mailgun SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Anokhi Silks <youraddress@gmail.com>"
STORE_OWNER_EMAIL=youraddress@gmail.com
